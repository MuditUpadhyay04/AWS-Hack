# Copy to ".env.local" and fill in. ".env*" is gitignored, so real values never hit git.

# Teammate 2's roadmap API (e.g. an AWS API Gateway HTTP endpoint).
# Leave unset to use the built-in mock roadmap.
# VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# AWS Bedrock — used by the game's level generator (src/components/LevelGen.tsx).
# WARNING: every VITE_* var is bundled into the client and visible to anyone who
# opens the app. Use short-lived / tightly-scoped credentials here, and prefer
# moving Bedrock calls behind the backend before any real public deployment.
# VITE_AWS_REGION=us-east-1
# VITE_AWS_ACCESS_KEY_ID=your_access_key_id
# VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ElevenLabs — voice-powered interview (spoken clarifying questions).
# Without these the interview stays text-only (graceful fallback).
# VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# VITE_ELEVENLABS_VOICE_ID=your_voice_id

# OpenAI — validates the game's "what have you done?" reflection before a level
# unlocks. Without it, a simple effort heuristic is used. (Bundled client-side —
# use a usage-capped, rotatable key.)
# VITE_OPENAI_API_KEY=your_openai_api_key
